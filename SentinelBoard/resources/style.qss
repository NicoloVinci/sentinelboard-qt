/* ── Finestra generale ── */
QMainWindow, QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* ── Pagina Start ── */
#pageStart {
    background-color: #1e1e2e;
}

#labelTitle {
    font-size: 32px;
    font-weight: bold;
    color: #cba6f7;
    padding: 16px;
}

#labelSubtitle {
    font-size: 13px;
    color: #a6adc8;
}

#labelStartupStatus {
    font-size: 12px;
    color: #6c7086;
    padding: 4px;
}

/* ── Bottoni ── */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #45475a;
    border-color: #cba6f7;
}

QPushButton:pressed {
    background-color: #cba6f7;
    color: #1e1e2e;
}

#btnStartSystem {
    background-color: #a6e3a1;
    color: #1e1e2e;
    font-weight: bold;
    border: none;
    padding: 8px 32px;
    font-size: 14px;
}

#btnStartSystem:hover  { background-color: #94e2a1; }
#btnStartSystem:pressed { background-color: #74c991; }

#btnStopSystem {
    background-color: #f38ba8;
    color: #1e1e2e;
    font-weight: bold;
    border: none;
}

#btnStopSystem:hover  { background-color: #e07090; }

/* ── ComboBox ── */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 10px;
}

QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #313244;
    color: #cdd6f4;
    selection-background-color: #45475a;
}

/* ── SpinBox ── */
QDoubleSpinBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 8px;
}

/* ── Dashboard ── */
#pageDashboard {
    background-color: #1e1e2e;
}

#labelDashboardTitle {
    font-size: 18px;
    font-weight: bold;
    color: #cba6f7;
    padding: 4px;
}

#labelSampleCount {
    font-size: 11px;
    color: #6c7086;
}

#labelTemp, #labelHum, #labelLight, #labelStatus {
    font-size: 14px;
    font-weight: bold;
    color: #cdd6f4;
    min-width: 80px;
}

/* ── Grafici ── */
#chartsContainer {
    background-color: #181825;
    border-radius: 8px;
}

/* ── About ── */
#pageAbout {
    background-color: #1e1e2e;
}

#labelAboutTitle {
    font-size: 22px;
    font-weight: bold;
    color: #cba6f7;
}

#labelAboutText {
    color: #a6adc8;
    font-size: 13px;
    line-height: 1.6;
}
