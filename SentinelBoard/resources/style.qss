/* ═══════════════════════════════════════════
   SENTINELBOARD — Dark Tech Professional Theme
   ═══════════════════════════════════════════ */

/* ── Base ── */
QMainWindow, QWidget {
    background-color: #0a0e1a;
    color: #e2e8f0;
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QStackedWidget, QWidget#pageStart, QWidget#pageDashboard, QWidget#pageAbout {
    background-color: #0a0e1a;
}

QLabel {
    color: #e2e8f0;
    background: transparent;
}

QLabel#labelTitle {
    font-size: 36px;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 2px;
    padding: 20px 0px 4px 0px;
    qproperty-alignment: AlignCenter;
}

QLabel#labelSubtitle {
    font-size: 13px;
    color: #64748b;
    qproperty-alignment: AlignCenter;
    padding-bottom: 8px;
}

QLabel#labelStartupStatus {
    font-size: 11px;
    color: #475569;
    qproperty-alignment: AlignCenter;
    padding: 2px;
}

QLabel#labelDashboardTitle {
    font-size: 20px;
    font-weight: 700;
    color: #38bdf8;
    letter-spacing: 1px;
    qproperty-alignment: AlignCenter;
    padding: 6px 0px;
}

QLabel#labelSampleCount {
    font-size: 11px;
    color: #475569;
    qproperty-alignment: AlignCenter;
}

QLabel#labelTemp, QLabel#labelHum, QLabel#labelLight, QLabel#labelStatus {
    font-size: 15px;
    font-weight: 600;
    color: #f1f5f9;
    min-width: 90px;
    padding: 2px 4px;
}

QLabel#labelAboutTitle {
    font-size: 24px;
    font-weight: 700;
    color: #38bdf8;
    qproperty-alignment: AlignCenter;
    padding: 12px;
}

QLabel#labelAboutText {
    color: #94a3b8;
    font-size: 13px;
    qproperty-alignment: AlignCenter;
}

QLabel#labelThresholdTemp, QLabel#labelThresholdHum {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 500;
}

/* ═══════════════════════════════
   PULSANTI
   ═══════════════════════════════ */
QPushButton {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 7px 20px;
    min-width: 90px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #273449;
    border-color: #38bdf8;
    color: #f1f5f9;
}

QPushButton:pressed {
    background-color: #0f172a;
    border-color: #0ea5e9;
}

QPushButton#btnStartSystem {
    background-color: #064e3b;
    color: #6ee7b7;
    border: 1px solid #059669;
    border-radius: 8px;
    padding: 10px 40px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    min-width: 140px;
}
QPushButton#btnStartSystem:hover {
    background-color: #065f46;
    border-color: #34d399;
    color: #a7f3d0;
}
QPushButton#btnStartSystem:pressed {
    background-color: #022c22;
}

QPushButton#btnStopSystem {
    background-color: #450a0a;
    color: #fca5a5;
    border: 1px solid #b91c1c;
    border-radius: 7px;
    padding: 7px 20px;
    font-weight: 600;
}
QPushButton#btnStopSystem:hover {
    background-color: #5c1010;
    border-color: #ef4444;
    color: #fecaca;
}
QPushButton#btnStopSystem:pressed {
    background-color: #2d0606;
}

QPushButton#btnExportCsv {
    background-color: #0c2a4a;
    color: #7dd3fc;
    border: 1px solid #0369a1;
    border-radius: 7px;
    font-weight: 600;
}
QPushButton#btnExportCsv:hover {
    background-color: #0f3460;
    border-color: #38bdf8;
    color: #bae6fd;
}

QPushButton#btnPauseResume {
    background-color: #2d1f00;
    color: #fcd34d;
    border: 1px solid #b45309;
    border-radius: 7px;
    font-weight: 600;
}
QPushButton#btnPauseResume:hover {
    background-color: #3d2a00;
    border-color: #f59e0b;
    color: #fde68a;
}

/* ═══════════════════════════════
   COMBOBOX
   ═══════════════════════════════ */
QComboBox {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 6px 12px;
    min-width: 120px;
}
QComboBox:hover {
    border-color: #38bdf8;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    selection-background-color: #0369a1;
    selection-color: #f0f9ff;
    outline: none;
}

/* ═══════════════════════════════
   SPINBOX — pulsantini nascosti
   ═══════════════════════════════ */
QDoubleSpinBox {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 7px;
    padding: 5px 8px;
    min-width: 80px;
}
QDoubleSpinBox:hover {
    border-color: #38bdf8;
}
QDoubleSpinBox:focus {
    border-color: #0ea5e9;
    background-color: #162032;
}
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

/* ═══════════════════════════════
   CHARTS CONTAINER
   ═══════════════════════════════ */
QWidget#chartsContainer {
    background-color: #060911;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

/* ═══════════════════════════════
   SCROLLBAR
   ═══════════════════════════════ */
QScrollBar:vertical {
    background: #0f172a;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
